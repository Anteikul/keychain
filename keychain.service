[Unit]
Description=Local encrypted Keychain
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/keychain
ExecStart=/usr/bin/python3 /opt/keychain/app.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

# Basic service hardening. The application still needs port 80 and its data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/keychain
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
